{
  "name": "@mainzjs/cli-node",
  "version": "0.1.0-alpha.46",
  "description": "Node/npm Mainz CLI",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soguten/mainz-cli-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mainz": "bin/mainz.js",
    "mainz-cli-node": "bin/mainz.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "mainzCliHosts": {
    "framework": "jsr:@mainz/mainz@0.1.0-alpha.46",
    "cliDeno": "jsr:@mainz/cli-deno@0.1.0-alpha.46",
    "cliBun": "@mainzjs/cli-bun@0.1.0-alpha.46",
    "cliNode": "@mainzjs/cli-node@0.1.0-alpha.46"
  },
  "files": [
    "bin",
    "README.md",
    "src/cli/cli-delegation.js",
    "src/cli/dev.js",
    "src/cli/main.js",
    "src/cli/package-specifiers.js",
    "src/cli/project-config.js",
    "src/templates/index.js",
    "src/templates/load-template.js",
    "src/templates/materialize-template.js",
    "templates"
  ],
  "scripts": {
    "smoke": "node ./bin/mainz.js --help",
    "sync:templates": "node ./scripts/sync-templates.mjs",
    "test": "npm run test:templates && npm run test:cli",
    "test:templates": "node --test ./src/templates/materialize-template.test.js",
    "test:cli": "node --test ./src/cli/main.test.js"
  }
}
